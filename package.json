{
  "name": "figurepinner-site",
  "version": "0.2.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "traffic": "node scripts/daily-uniques.mjs",
    "kb:d1:check": "node scripts/build-kb-d1-sql.mjs --check",
    "kb:d1:build": "node scripts/build-kb-d1-sql.mjs --out .tmp/kb-d1",
    "kb:d1:remote-check": "node scripts/check-kb-d1-remote.mjs",
    "kb:d1:canary-audit": "node scripts/audit-kb-d1-canary.mjs",
    "kb:d1:canary-live": "node scripts/check-kb-d1-canary-live.mjs",
    "build:cf": "npx @opennextjs/cloudflare build",
    "deploy": "node scripts/predeploy-clean-check.mjs && npx @opennextjs/cloudflare build && (npx @opennextjs/cloudflare deploy --cacheChunkSize 10 || npx @opennextjs/cloudflare deploy --cacheChunkSize 10) && node scripts/indexnow-ping.mjs && node scripts/post-deploy-git-check.mjs",
    "deploy:seed": "npx @opennextjs/cloudflare populateCache remote || echo SEED FAILED non-fatal: prerendered pages will ISR-fill on first request instead"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.39.5",
    "lucide-react": "^1.20.0",
    "next": "^15.5.20",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.19.1",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "typescript": "^5",
    "wrangler": "^4.107.0"
  }
}
