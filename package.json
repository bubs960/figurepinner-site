{
  "name": "figurepinner-site",
  "version": "0.2.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/build-kb-stats.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --import ./scripts/register-ts-loader.mjs --test tests/**/*.test.mjs",
    "smoke": "node scripts/post-deploy-smoke-probe.mjs",
    "check:index-bar-drift": "node scripts/check-index-bar-drift.mjs",
    "traffic": "node scripts/daily-uniques.mjs",
    "kb:d1:check": "node scripts/build-kb-d1-sql.mjs --check",
    "kb:d1:build": "node scripts/build-kb-d1-sql.mjs --out .tmp/kb-d1",
    "kb:d1:remote-check": "node scripts/check-kb-d1-remote.mjs",
    "kb:d1:build-staging": "node scripts/build-kb-d1-sql.mjs --out .tmp/kb-d1-swap --table kb_figures_new",
    "kb:enrichment-dates": "node scripts/generate-enrichment-dates.mjs",
    "kb:d1:swap": "node scripts/kb-d1-swap.mjs",
    "kb:d1:swap-rehearse": "node scripts/kb-d1-swap.mjs rehearse",
    "kb:d1:canary-audit": "node scripts/audit-kb-d1-canary.mjs",
    "kb:d1:canary-live": "node scripts/check-kb-d1-canary-live.mjs",
    "build:cf": "node scripts/build-kb-stats.mjs && npx @opennextjs/cloudflare build && node scripts/assert-no-runtime-kb-in-handler.mjs",
    "prewarm": "node scripts/post-deploy-prewarm.mjs",
    "deploy": "node scripts/predeploy-clean-check.mjs && node scripts/run-seo-preflight.mjs && npm test && node scripts/build-kb-stats.mjs && npx @opennextjs/cloudflare build && node scripts/assert-no-runtime-kb-in-handler.mjs && (npx @opennextjs/cloudflare deploy --cacheChunkSize 10 || npx @opennextjs/cloudflare deploy --cacheChunkSize 10) && node scripts/kv-purge-stale-isr.mjs --execute && node scripts/purge-cache.mjs && node scripts/post-deploy-prewarm.mjs && node scripts/indexnow-ping.mjs && node scripts/post-deploy-git-check.mjs",
    "deploy:seed": "npx @opennextjs/cloudflare populateCache remote || echo SEED FAILED non-fatal: prerendered pages will ISR-fill on first request instead"
  },
  "dependencies": {
    "@cf-wasm/photon": "0.4.0",
    "@clerk/nextjs": "^6.39.5",
    "next": "^15.5.20",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.19.1",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "typescript": "^5",
    "wrangler": "^4.107.0"
  }
}
