# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage
/.tmp/
/.hermes/
/.playwright-cli/
/output/playwright/

# next.js
/.next/
/.next-*/
/out/

# Cloudflare / next-on-pages build output
/.vercel/
/.wrangler/
/.open-next/
# wrangler local state for the workers/ sub-projects too (e.g. lister's
# figurepinner-images deploys from workers/ — local miniflare state, never
# ship it, never commit it; root-anchored /.wrangler/ above doesn't cover it)
workers/.wrangler/

# production
/build

# env files (never commit secrets)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production
.env.production.local

# explicit secret files (catch-all so a mis-named secret file can't leak)
*secrets*.txt
*secrets*.json
alerts-secrets.txt
*.pem
*.key
credentials.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editors
.idea/

# OS
.DS_Store
Thumbs.db

# logs
*.log
npm-debug.log*

# local deploy-script run state (machine-specific, no secrets, safe to delete).
# The .tmp-<pid> variant is the atomic-write scratch file — it's supposed to
# be transient (write, then rename over the real file), but a Windows-only
# EPERM race (something else briefly holding the destination handle, e.g.
# antivirus) can leave it stranded. Ignore it too so a deploy that hits that
# race doesn't surface as a false "uncommitted change" warning.
/.kv-purge-state.json
/.kv-purge-state.json.tmp-*
# IndexNow failed-batch log (machine-local; failed submits recorded for later
# re-submission via --urls-file — see scripts/indexnow-ping.mjs item C note)
/.indexnow-failures.jsonl

# hub-isr-check.mjs output — machine-local scratch, mode-specific by design
# (2026-07-27: a shared filename between baseline/verify runs once silently
# overwrote the pre-fix baseline with post-fix data).
/hub-isr-baseline.json
/hub-isr-verify.json

# Plugin/skill artifacts dropped into .claude/ by Cowork sessions - never ship, never commit
.claude/*
!.claude/launch.json

# Dated sync-backup copy of the KB reference file -- 28 commits of drift, pure
# safety-copy noise from the nightly auto-sync job. Identified 2026-07-27
# (MASTER-FIX-BLUEPRINT Phase 4). Leaving figures-reference-v2.js and
# figures-reference-v2.slim.js tracked -- both look like real build inputs,
# not backups; not touching those without confirming the build actually needs them.
src/data/figures-reference-v2.js.backup-pre-sync

# OOM gate (2026-09-01): 8MB prose-free catalog projection, regenerated by scripts/build-kb-stats.mjs on every build
/src/data/kb-lite.generated.json

# speed-probe (2026-09-02): per-run JSONL log, live task state — never commit (R18: outputs/ is operational)
/outputs/
