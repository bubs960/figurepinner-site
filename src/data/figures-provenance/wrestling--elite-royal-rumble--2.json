    },
    {
     "quote_id": "f_q2",
     "source_id": "f_s1",
     "text": "Mattel's True FX sculpting resulted in an amazing head sculpt that really nailed his likeness.",
     "scope": {
      "kind": "figure",
      "character_canonical": "titus-oneil",
      "manufacturer": "mattel",
      "product_line": "elite-royal-rumble",
      "year": 2021,
      "character_variant": null,
      "condition": null
     }
    },
    {
     "quote_id": "f_q3",
     "source_id": "f_s1",
     "text": "The tampo on his tights is applied cleanly. As usual the trick is getting the yellow strong enough to not have the black bleeding though.",
