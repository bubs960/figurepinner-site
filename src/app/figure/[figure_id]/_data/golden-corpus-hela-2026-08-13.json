    {
     "quote_id": "b_q1",
     "source_id": "b_s1",
     "text": "This Hela toy was added on August 2017 and also released in 2017 with a retail price of $19.99.",
     "scope": {
      "kind": "figure",
      "manufacturer": "hasbro",
      "product_line": "marvel-legends",
      "year": 2017,
      "character_canonical": "hela",
      "character_variant": null,
      "condition": null
     }
    },
    {
     "quote_id": "b_q2",
     "source_id": "b_s1",
     "text": "It is part of the Hulk Build A Figure collection and includes the Arm to complete the Hulk BAF which includes 7 action figures.",
     "scope": {
      "kind": "wave",
      "manufacturer": "hasbro",
      "product_line": "marvel-legends",
      "year": 2017,
      "character_canonical": "hela",
      "character_variant": null,
      "condition": null
     }
    },
    {
     "quote_id": "b_q3",
     "source_id": "b_s1",
     "text": "This is a really popular toy with 586 collectors having it in their user collections.",
     "scope": {
      "kind": "figure",
      "manufacturer": "hasbro",
      "product_line": "marvel-legends",
      "year": 2017,
      "character_canonical": "hela",
      "character_variant": null,
      "condition": null
     }
    },
    {
     "quote_id": "b_q4",
     "source_id": "b_s2",
     "text": "Hela\" contributes the \"Arm\" component to the Build-A-Figure.",
     "scope": {
      "kind": "wave",
      "manufacturer": "hasbro",
      "product_line": "marvel-legends",
      "year": 2017,
      "character_canonical": "hela",
      "character_variant": null,
      "condition": null
     }
    },
    {
     "quote_id": "b_q5",
     "source_id": "b_s2",
     "text": "All figures in this wave were released in \"2017.\"",
     "scope": {
      "kind": "wave",
      "manufacturer": "hasbro",
      "product_line": "marvel-legends",
      "year": 2017,
      "character_canonical": null,
      "character_variant": null,
      "condition": null
     }
    },
    {
     "quote_id": "b_q6",
     "source_id": "b_s4",
     "text": "Opened\" condition with \"Good - Some wear and flaws\" figure grade and \"No Package",
     "scope": {
      "kind": "figure",
      "manufacturer": "hasbro",
      "product_line": "marvel-legends",
      "year": null,
